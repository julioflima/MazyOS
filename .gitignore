# Sistema operacional
.DS_Store
Thumbs.db

# Editores
.vscode/
.idea/

# Claude Code (sessões locais, não devem ir pro repo)
.claude/projects/
.claude/sessions/
.claude/shell-snapshots/
.claude/telemetry/
.claude/file-history/
.claude/backups/

# Dependências
node_modules/

# Arquivos temporários
*.log
*.tmp

# Drop zone do usuário (só o README vai versionado)
dados/*
!dados/README.md

# candidatas da mineração (pesado — só a capa.jpg escolhida vai pro repo)
marketing/conteudo/videos/**/candidatas/
marketing/conteudo/.render/

# segredos — nunca commitar
.env

# python
__pycache__/
*.pyc
.mineracao.lock
.emandamento

# Vídeo NUNCA vai pro repositório (regra do Julio). O lugar de mídia é
# /Users/juliolima/Documents/media/multiplic/consorcios — o repo é de
# código e texto. Um mp4 de 42 MB no histórico não sai mais de lá.
*.mp4
*.wav
*.mov

# Intermediários da esteira de vídeo: cenas renderizadas, mix de áudio,
# plano de tempo. Tudo isso se regera a partir do conteudo.json e das
# imagens escolhidas.
marketing/conteudo/videos/**/podcast*/
marketing/conteudo/videos/**/video/
marketing/conteudo/videos/**/cenas/[0-9]*/

# Imagem gerada também é mídia (regra do Julio, 19/09/26): os slides
# renderizados eram 933 PNGs e 190 MB — 84% do repositório. São derivados:
# saem do carrossel.html mais a imagem escolhida.
# Os arquivos continuam no disco, onde os scripts esperam. Só não vão pro git.
marketing/**/*.png
marketing/**/*.jpg
marketing/**/*.jpeg
marketing/**/*.webp

# O que SE MANTÉM em marketing/conteudo/videos/: conteudo.json, roteiro.json,
# legenda.md, carrossel.html, cenas/buscas.json, cenas/escolhidas.json e
# credito-capa.json. É o que permite reconstruir qualquer peça.
